rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /llegadas/{id} {
      allow read: if true;

      // Solo se permite crear registros con forma válida; nadie puede editar ni borrar
      // (los registros viejos los elimina la política TTL sobre el campo "expiraEn").
      allow create: if request.resource.data.keys().size() <= 10
        && request.resource.data.tipo in ['recarga', 'recepcion']
        && request.resource.data.creadoEn == request.time
        && request.resource.data.eta is timestamp
        && request.resource.data.eta < request.time + duration.value(12, 'h')
        && request.resource.data.expiraEn is timestamp
        && request.resource.data.expiraEn > request.resource.data.eta;

      allow update, delete: if false;
    }
  }
}
