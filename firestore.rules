rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /llegadas/{id} {
      function valida(d) {
        return d.keys().size() <= 10
          && d.tipo in ['recarga', 'recepcion']
          && d.eta is timestamp
          && d.eta < request.time + duration.value(12, 'h')
          && d.expiraEn is timestamp
          && d.expiraEn > d.eta;
      }

      allow read: if true;

      allow create: if valida(request.resource.data)
        && request.resource.data.creadoEn == request.time;

      // Se puede modificar un aviso, pero no cambiar su tipo ni su fecha de creación.
      allow update: if valida(request.resource.data)
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.creadoEn == resource.data.creadoEn;

      // Distribución y CL pueden eliminar avisos. Los vencidos los borra la política TTL ("expiraEn").
      allow delete: if true;
    }
  }
}
